# Terraform 設定値テンプレート
# このファイルを credentials.tfvars にコピーして、値を適切に設定してください
# ※ credentials.tfvars は .gitignore に登録済みで、git に含まれません

# ============================================================================
# AWS 基本設定
# ============================================================================

aws_region = "ap-northeast-1"  # AWS リージョン（東京）

# ============================================================================
# EC2 インスタンス設定
# ============================================================================

instance_type           = "t3.micro"              # インスタンスタイプ（無料枠対象）
instance_name           = "kanban-app-server"     # インスタンス名
ami_owner              = "amazon"                 # AMI オーナー
ami_name_pattern       = "amzn2-ami-hvm-*-x86_64-gp3"  # AMI パターン

# ============================================================================
# RDS PostgreSQL 設定
# ============================================================================

db_instance_class      = "db.t3.micro"            # インスタンスクラス（無料枠対象）
db_engine              = "postgres"               # DB エンジン
db_engine_version      = "15.4"                   # PostgreSQL バージョン
db_allocated_storage   = 20                       # ストレージ（GB）
db_name                = "kanbandb"               # データベース名
db_username            = "kanbanAdmin"            # DB ユーザー名
# db_password はコマンドラインで指定するか、別ファイルで管理してください

# ============================================================================
# セキュリティ設定
# ============================================================================

key_pair_name          = "kanban-key"             # SSH キーペア名
allowed_ssh_ips        = ["0.0.0.0/0"]            # SSH 許可 IP（本番では制限推奨）

# ============================================================================
# ネットワーク設定
# ============================================================================

enable_public_access   = true                     # EC2 パブリックアクセス
db_publicly_accessible = false                    # RDS パブリックアクセス（セキュリティのため false）

# ============================================================================
# バックアップ・保守設定
# ============================================================================

backup_retention_days  = 7                        # バックアップ保持期間（日）
preferred_backup_window = "03:00-04:00"           # バックアップ時間帯（UTC）
preferred_maintenance_window = "sun:04:00-sun:05:00"  # メンテナンス時間帯

# ============================================================================
# タグ設定
# ============================================================================

project_name           = "kanban-task-app"        # プロジェクト名
environment            = "development"            # 環境（development/staging/production）
cost_center            = "engineering"            # コストセンター
